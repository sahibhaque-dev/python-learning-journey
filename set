# The union() and update() methods joins all items from both sets.


set_2={'hi','hello ',67,89,90,9,67,'&&&&'}
print('we have the set1 : ',set_2)
set_3={'hellom ',78,87,"%6 hi",67}
print('we have the set2 : ',set_3)
set_1={'shib haque' , 'hi ','ki hoise tmr ', 67}
print('we have the set3 : ',set_1)

set_4= set_2.union(set_3)
print('we have the joined  set3 : ',set_4)
set_5 = set_1.update(set_3)
print('we have( +3) the set 5 : ',set_5)

# ntersection() method keeps ONLY the duplicates.

intersection= set_2.intersection(set_3)
print('we have the intersection : ',intersection)

# The difference() method keeps the items from the first set that are not in the other set(s).
different = set_2.difference(set_3)
print('we have the different : ',different)

# The symmetric_difference() method keeps all items EXCEPT the duplicates.

symetric= set_2.symmetric_difference(set_3)
print('we have the symetric difference : ',symetric)

